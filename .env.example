# Application Settings
# HOST=127.0.0.1
# PORT=8000
# ENVIRONMENT=development

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# CORS — Allowed Origins
# Comma-separated list of origins that are permitted to call the API.
# Local development (Vite default port):
#   ALLOWED_ORIGINS=http://localhost:5173
# Production (set this to your live portfolio URL in your hosting dashboard):
#   ALLOWED_ORIGINS=https://portfolio-8zu9.vercel.app
# Multiple origins (e.g. production + preview domain):
#   ALLOWED_ORIGINS=https://portfolio-8zu9.vercel.app,https://preview.portfolio.com
# WARNING: Do NOT use * — this exposes the Gemini API to abuse from any website.
ALLOWED_ORIGINS=http://localhost:5173

# Note: DO NOT commit real API keys or secrets to version control.
